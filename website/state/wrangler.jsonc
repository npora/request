{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "npora-request-demo-state",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "DEMO_STATE", "class_name": "DemoState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoState"] }]
}
