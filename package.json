{
  "name": "@npora/request",
  "version": "1.15.1",
  "description": "A modern, TypeScript-first HTTP client powered by the Fetch API.",
  "keywords": [
    "npora",
    "request",
    "fetch",
    "http",
    "http-client",
    "typescript",
    "retry",
    "cache",
    "sse",
    "ndjson",
    "standard-schema",
    "circuit-breaker",
    "web-worker"
  ],
  "homepage": "https://github.com/npora/request",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npora/request.git"
  },
  "bugs": {
    "url": "https://github.com/npora/request/issues"
  },
  "license": "MIT",
  "author": "Npora Team",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js",
      "require": "./dist/plugins.cjs"
    },
    "./plugins/auth": {
      "types": "./dist/plugins/auth.d.ts",
      "import": "./dist/plugins/auth.js",
      "require": "./dist/plugins/auth.cjs"
    },
    "./plugins/cache": {
      "types": "./dist/plugins/cache.d.ts",
      "import": "./dist/plugins/cache.js",
      "require": "./dist/plugins/cache.cjs"
    },
    "./plugins/circuit-breaker": {
      "types": "./dist/plugins/circuit-breaker.d.ts",
      "import": "./dist/plugins/circuit-breaker.js",
      "require": "./dist/plugins/circuit-breaker.cjs"
    },
    "./plugins/concurrency": {
      "types": "./dist/plugins/concurrency.d.ts",
      "import": "./dist/plugins/concurrency.js",
      "require": "./dist/plugins/concurrency.cjs"
    },
    "./plugins/download": {
      "types": "./dist/plugins/download.d.ts",
      "import": "./dist/plugins/download.js",
      "require": "./dist/plugins/download.cjs"
    },
    "./plugins/logger": {
      "types": "./dist/plugins/logger.d.ts",
      "import": "./dist/plugins/logger.js",
      "require": "./dist/plugins/logger.cjs"
    },
    "./plugins/retry": {
      "types": "./dist/plugins/retry.d.ts",
      "import": "./dist/plugins/retry.js",
      "require": "./dist/plugins/retry.cjs"
    },
    "./plugins/upload": {
      "types": "./dist/plugins/upload.d.ts",
      "import": "./dist/plugins/upload.js",
      "require": "./dist/plugins/upload.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./adapters/mock": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm test:package && changeset publish",
    "example": "tsx examples/basic.ts",
    "example:plugins": "tsx examples/plugins.ts",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "test:security": "vitest run test/security.test.ts",
    "test:docs": "node test/docs.mjs",
    "test:release-workflow": "node test/release-workflow.mjs",
    "test:types": "pnpm build && tsc -p test/types/tsconfig.json",
    "test:examples": "tsc -p examples/tsconfig.json",
    "test:package": "node test/package/esm.mjs && node test/package/cjs.cjs && node test/package/subpaths.mjs && node test/package/subpaths.cjs && node test/package/api-exports.mjs && node test/package/api-contract.mjs && node test/package/npm-pack-result.test.mjs && node test/package/manifest.mjs && pnpm test:size",
    "test:registry": "node test/package/registry-install.mjs",
    "test:size": "node test/package/size.mjs",
    "test:browser": "playwright test --config=browser/playwright.config.ts",
    "test:browser:ui": "playwright test --config=browser/playwright.config.ts --ui",
    "test:browser:report": "playwright show-report playwright-report",
    "audit:dependencies": "pnpm audit --audit-level high",
    "audit:malware": "node scripts/audit-malware.mjs",
    "audit:signatures": "pnpm audit signatures",
    "benchmark": "tsx benchmark/request.ts",
    "benchmark:http": "tsx benchmark/http-concurrency.ts",
    "benchmark:libraries": "npm --prefix benchmark/competitors run benchmark",
    "benchmark:libraries:install": "npm install --prefix benchmark/competitors --ignore-scripts --no-audit --no-fund",
    "stress": "node --expose-gc --import tsx benchmark/stress.ts",
    "benchmark:types": "tsc -p benchmark/tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "typescript-api": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  }
}
