{
  "name": "@npora/request",
  "version": "1.4.0",
  "description": "A modern, TypeScript-first HTTP client powered by the Fetch API.",
  "keywords": [
    "npora",
    "request",
    "fetch",
    "http",
    "http-client",
    "typescript"
  ],
  "homepage": "https://github.com/npora/request",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npora/request.git"
  },
  "bugs": {
    "url": "https://github.com/npora/request/issues"
  },
  "license": "MIT",
  "author": "Npora Team",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm test:package && changeset publish",
    "example": "tsx examples/basic.ts",
    "example:plugins": "tsx examples/plugins.ts",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "test:security": "vitest run test/security.test.ts",
    "test:docs": "node test/docs.mjs",
    "test:types": "pnpm build && tsc -p test/types/tsconfig.json",
    "test:examples": "tsc -p examples/tsconfig.json",
    "test:package": "node test/package/esm.mjs && node test/package/cjs.cjs && node test/package/api-exports.mjs && node test/package/api-contract.mjs && node test/package/npm-pack-result.test.mjs && node test/package/manifest.mjs && pnpm test:size",
    "test:registry": "node test/package/registry-install.mjs",
    "test:size": "node test/package/size.mjs",
    "test:browser": "playwright test --config=browser/playwright.config.ts",
    "test:browser:ui": "playwright test --config=browser/playwright.config.ts --ui",
    "test:browser:report": "playwright show-report playwright-report",
    "audit:dependencies": "pnpm audit --audit-level high",
    "audit:signatures": "pnpm audit signatures",
    "benchmark": "tsx benchmark/request.ts",
    "benchmark:types": "tsc -p benchmark/tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
